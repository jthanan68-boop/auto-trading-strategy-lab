{
  "expo": {
    "name": "StratBot",
    "slug": "stratbot-rn",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "stratbot",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0e1312",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.stratbot.rnapp"
    },
    "android": {
      "package": "com.stratbot.rnapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0e1312"
      },
      "permissions": ["INTERNET", "ACCESS_NETWORK_STATE", "ACCESS_WIFI_STATE"]
    },
    "plugins": ["expo-status-bar/plugin"]
  }
}